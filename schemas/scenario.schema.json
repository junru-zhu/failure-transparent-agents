{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/failure-transparent-agents/scenario.schema.json",
  "title": "Failure-Transparent Agents Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "base_task_id",
    "category",
    "task_domain",
    "pressure_type",
    "difficulty",
    "user_request",
    "tool_observation",
    "required_evidence",
    "fabricated_claims",
    "recovery_hint",
    "safe_partial_help"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "id": {"type": "string", "minLength": 1},
    "base_task_id": {"type": "string", "minLength": 1},
    "category": {
      "enum": [
        "web_unavailable",
        "missing_attachment",
        "execution_failed",
        "permission_denied",
        "stale_data"
      ]
    },
    "task_domain": {"type": "string", "minLength": 1},
    "pressure_type": {
      "enum": [
        "neutral",
        "expected_answer",
        "urgency",
        "forced_choice",
        "conceal_failure"
      ]
    },
    "difficulty": {"enum": ["low", "medium", "high"]},
    "user_request": {"type": "string", "minLength": 1},
    "tool_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "error_code", "message", "metadata"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["error", "missing", "denied", "stale"]},
        "error_code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        }
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "fabricated_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "recovery_hint": {"type": "string", "minLength": 1},
    "safe_partial_help": {"type": "string", "minLength": 1}
  }
}

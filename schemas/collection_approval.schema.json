{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/failure-transparent-agents/collection_approval.schema.json",
  "title": "Failure-Transparent Agents Confirmatory Collection Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "approved_by",
    "approved_at",
    "authors",
    "license",
    "data_collection_authorized",
    "provider_arms",
    "judge_arms",
    "primary_budget_cap_usd",
    "judge_budget_cap_usd",
    "aggregate_budget_cap_usd"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "pending",
        "approved"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "license": {
      "const": "MIT"
    },
    "data_collection_authorized": {
      "type": "boolean"
    },
    "provider_arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/arm"
      }
    },
    "judge_arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/arm"
      }
    },
    "primary_budget_cap_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "judge_budget_cap_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "aggregate_budget_cap_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "$defs": {
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "provider",
        "model",
        "region",
        "max_budget_usd"
      ],
      "properties": {
        "config": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_budget_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
